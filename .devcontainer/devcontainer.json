{
	"name": "ollama",
	"build": {
		"dockerfile": "dev.Dockerfile",
		"context": ".."
	},
	"overrideCommand": true,
	"postCreateCommand": "docker network create zpm-test-nw || true && sudo chown -R vscode ./data",
	"postAttachCommand": "docker compose -f .devcontainer/docker-compose.services.yml up -d",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"4ops.terraform"
			]
		}
	},
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Immich frontend",
			"onAutoForward": "notify"
		}
	},
	"remoteUser": "vscode",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/nils-geistmann/devcontainers-features/create-remote-user:0": {
			"passwordLessSudo": true,
			"additionalGroups": ["docker"]
		}
	}
}